# Copy this file to .env and replace the placeholders with generated secrets.
# Generate JWT_SECRET with: openssl rand -base64 64
DB_NAME=banklink
DB_USER=banklink
DB_PASSWORD=replace_with_a_long_random_database_password
JWT_SECRET=replace_with_base64_encoded_64_byte_jwt_key
CORS_ALLOWED_ORIGINS=http://localhost
HTTP_PORT=80
